# Copy this file to .env (which git ignores) and fill in your values:
#   cp .env.example .env

# Required: create one at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Optional but polite: NCBI asks API users for a contact email.
NCBI_EMAIL=
# Optional: raises PubMed's rate limit from 3 to 10 requests/second.
# Free at https://account.ncbi.nlm.nih.gov/settings/ -> "API Key Management".
NCBI_API_KEY=
